# Atlas backend environment variables.
# Copy this file to `.env` and fill in the values.

# Secret used to verify GitHub webhook signatures (HMAC SHA-256).
# Leave empty in local development to disable verification (not recommended
# for production). Never commit the real secret to Git.
GITHUB_WEBHOOK_SECRET=atlas_github_test_secret_2026

# The deployed frontend URL, used for CORS. In development, localhost Vite
# origins are always allowed automatically.
# Example: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173
